                    "remainedQuantityLots": {
                      "type": "number",
                      "format": "double",
                      "description": "Оставшееся количество (в лотах)"
                    },
                    "executedQuantityLots": {
                      "type": "number",
                      "format": "double",
                      "description": "Исполненное количество (в лотах)"
                    },
                    "linkedOrder": {
                      "type": "string",
                      "description": "Номер связанной заявки"
                    },
                    "stopOrder": {
                      "type": "string",
                      "description": "Номер стоп-заявки"
                    },
                    "visible": {
                      "type": "number",
                      "format": "double",
                      "description": "Видимая часть айсберг-заявки"
                    },
                    "marketTakeProfit": {
                      "type": "integer",
                      "enum": [
                        1,
                        2
                      ],
                      "description": "Признак рыночного тейк-профита<br/>`1` – Рыночная заявка<br/>`2` – Лимитная заявка"
                    },
                    "marketStopLoss": {
                      "type": "integer",
                      "enum": [
                        1,
                        2
                      ],
                      "description": "Признак рыночного стоп-лосса<br/>`1` – Рыночная заявка<br/>`2` – Лимитная заявка"
                    },
                    "positionPriceStop": {
                      "type": "number",
                      "format": "double",
                      "description": "Цена стопа по позиции"
                    },
                    "positionPriceLimit": {
                      "type": "number",
                      "format": "double",
                      "description": "Лимитная цена по позиции"
                    }
                  },
                  "title": "OrdersSearchResponse"
                }
              },
              "totalRecords": {
                "type": "integer",
                "format": "int64",
                "description": "Общее количество записей"
              },
              "totalPages": {
                "type": "integer",
                "format": "int32",
                "description": "Общее количество страниц"
              }
            },
            "title": "ListResponseOrdersSearchResponse"
          }
        }
      }
