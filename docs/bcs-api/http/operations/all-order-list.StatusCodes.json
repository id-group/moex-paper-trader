    "429": {
      "description": "Too Many Requests",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "integer",
                "format": "int64"
              },
              "traceId": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "RESOURCE_EXHAUSTED",
                  "USER_BLOCKED",
                  "BAD_REQUEST",
                  "NOT_FOUND",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "CONFLICT",
                  "INTERNAL_SERVER_ERROR",
                  "SESSION_NOT_FOUND_ERROR",
                  "SESSION_EXPIRED_ERROR",
                  "SESSION_FAILED_ERROR"
                ]
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "payload": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object"
                      }
                    }
                  },
                  "title": "ErrorDetail"
                }
              },
              "displayOptions": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              }
            },
            "title": "ErrorResponse"
          }
        }
      }
    }
  }
}
